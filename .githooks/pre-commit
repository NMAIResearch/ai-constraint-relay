#!/usr/bin/env bash
set -e

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
WORKSPACE="$(dirname "$REPO_ROOT")"
TELLSCRUB=""

for candidate in "${TELLSCRUB_PATH:-}" "$WORKSPACE"/Workflow/*/tellscrub.py \
    "$WORKSPACE/House style/tellscrub.py" "$REPO_ROOT/House style/tellscrub.py"; do
    if [ -n "$candidate" ] && [ -f "$candidate" ]; then
        TELLSCRUB="$candidate"
        break
    fi
done

if [ -z "$TELLSCRUB" ]; then
    echo "Warning: tellscrub.py not found. Skipping pre-commit style scrub."
    exit 0
fi

STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)

if [ -n "$STAGED_MD" ]; then
    for file in $STAGED_MD; do
        if [ -f "$file" ]; then
            python3 "$TELLSCRUB" "$file"
        fi
    done
fi
